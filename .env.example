# Copy to .env (never commit it).
# Reviewer tokens for the dashboard/API/MCP when served beyond localhost: name:token pairs, tokens >= 16 chars.
ASSAY_TOKENS=alice:change-me-to-a-long-random-token,bob:another-long-random-token
# Single shared token alternative (reviewers then type their name in the dashboard):
# ASSAY_TOKEN=change-me-to-a-long-random-token

# Model provider (optional; without one Assay runs detectors and MCP hosts do the reasoning)
ANTHROPIC_API_KEY=
# or OpenAI (Responses API, default model gpt-5.5; web research supported):
# OPENAI_API_KEY=
# ASSAY_MODEL=claude-opus-5-5
# ASSAY_EFFORT=high
# On-premise model:
# ASSAY_PROVIDER=openai-compatible
# ASSAY_OPENAI_BASE_URL=http://localhost:11434/v1
# ASSAY_MODEL=qwen3-coder

# ASSAY_ALLOW_CLONE=false
# ASSAY_HOME=~/.assay

# Who may approve build/test commands on a shared server (comma separated names from ASSAY_TOKENS)
# ASSAY_APPROVERS=alice
# Directories where projects may be added by path (colon separated); required for shared servers
# ASSAY_PROJECT_ROOTS=/workspace
