NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgresql://clearance:change-me@localhost:5432/clearance
DB_DRIVER=postgres
DEMO_MODE=false
TRUST_PROXY=0
# In production use HTTPS and a verified Brevo sender.
BREVO_API_KEY=
MAIL_FROM=security@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register API_URL/api/auth/google/callback in Google Cloud.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional external research; requires project opt-in as well.
ALLOW_EXTERNAL_AI=false
ALLOW_REGULATORY_FETCH=false
# Server-side GitHub/Bitbucket shallow clones. HTTPS host allowlist; credentials are request-only.
ALLOW_REPOSITORY_FETCH=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Compose requires a strong, unique value. Do not use change-me in deployment.
POSTGRES_PASSWORD=
