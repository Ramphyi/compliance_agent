# Copy to .env (never commit it). Deployment guide: docs/DEPLOY.md.

# --- Accounts -----------------------------------------------------------------------------------
# First administrator, required when Acai listens beyond localhost (Docker always does).
# Generate with: openssl rand -hex 32. On start, if no enabled local administrator exists, Acai
# creates the user "admin" with this token. Sign in with it, create personal tokens, revoke it.
ACAI_ADMIN_TOKEN=
# More accounts: in the dashboard (Admin), or `acai users add <name> --role admin|member|viewer`
# (Docker: docker compose exec acai node /opt/acai/acai.mjs users add <name>). They are stored in
# $ACAI_HOME/auth.json.
# Optional read-only accounts from the environment (name:token pairs, tokens >= 16 characters).
# They are administrators unless ACAI_ADMINS lists who is; the others are members.
# ACAI_TOKENS=alice:<random>,bob:<random>
# ACAI_ADMINS=alice
# Members who may also approve build/test commands and change the model (administrators always may).
# ACAI_APPROVERS=bob

# --- Network ------------------------------------------------------------------------------------
# Public HTTPS origin of this server (no path). Turns on OAuth so ChatGPT and Claude.ai connectors can sign in.
# ACAI_PUBLIC_URL=https://acai.example.com
# Behind a reverse proxy or tunnel (the compose tls profile included):
# ACAI_TRUST_PROXY=1
# Compose tls profile (Caddy): the name people open, and acme | internal | files (see deploy/Caddyfile).
# ACAI_DOMAIN=acai.example.com
# ACAI_TLS=acme

# --- Repositories -------------------------------------------------------------------------------
# Docker: the folder of repositories to audit, and the port on this computer.
# ACAI_REPOS=./repos
# ACAI_HOST_PORT=4317
# ACAI_ALLOW_CLONE=false
# Directories where projects may be added by path (colon separated); required for shared servers
# ACAI_PROJECT_ROOTS=/workspace
# Repository webhooks: the secret you also enter in GitHub/GitLab (16+ characters), and a token
# to post commit statuses and pull request comments (and fetch private repositories).
# ACAI_WEBHOOK_SECRET=
# GITHUB_TOKEN=

# --- Model --------------------------------------------------------------------------------------
# Optional; without one Acai runs detectors and MCP hosts do the reasoning.
# You can also choose it on the dashboard's Model page. `acai providers` lists every provider.
ANTHROPIC_API_KEY=
# or OpenAI (Responses API, default model gpt-5.5; web research supported):
# OPENAI_API_KEY=
# ACAI_MODEL=claude-opus-5-5
# ACAI_EFFORT=high
# Any other provider by id, with its key: gemini, openrouter, mistral, groq, deepseek, xai, together, ollama, lmstudio
# ACAI_PROVIDER=gemini
# GEMINI_API_KEY=
# ACAI_MODEL=<model id from the provider>
# On-premise model (Ollama, vLLM, LiteLLM). In Docker, use host.docker.internal for a server on this host:
# ACAI_PROVIDER=openai-compatible
# ACAI_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# ACAI_MODEL=qwen3-coder
# Pin the model to this file (the dashboard can no longer change it):
# ACAI_MODEL_LOCKED=1

# ACAI_HOME=~/.acai
