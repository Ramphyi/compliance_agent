{
  "name": "acai-vscode",
  "displayName": "Acai Compliance",
  "description": "Self-hosted compliance audits in the editor: findings in the Problems panel, human review actions, the Acai dashboard, and an MCP server for agent mode.",
  "version": "0.1.0",
  "publisher": "acai-internal",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "compliance",
    "audit",
    "security",
    "mcp",
    "regulation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*",
    "onStartupFinished",
    "onView:acai.findings",
    "onView:acai.status",
    "onCommand:acai.openDashboard",
    "onCommand:acai.runAudit",
    "onCommand:acai.runAgentAudit",
    "onCommand:acai.setApiKey"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Acai starts a local server that reads the workspace and its audit state, and can run approved build and test commands. It only runs in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acai",
          "title": "Acai",
          "icon": "media/acai.svg"
        }
      ]
    },
    "views": {
      "acai": [
        {
          "id": "acai.findings",
          "name": "Findings",
          "icon": "media/acai.svg",
          "contextualTitle": "Acai"
        },
        {
          "id": "acai.status",
          "name": "Overview",
          "icon": "media/acai.svg",
          "contextualTitle": "Acai"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "acai.findings",
        "contents": "Open a folder to audit it with Acai.\n[Open Folder](command:vscode.openFolder)",
        "when": "!acai.hasFolder"
      },
      {
        "view": "acai.findings",
        "contents": "Starting the Acai server\u2026",
        "when": "acai.hasFolder && acai.serverState == starting"
      },
      {
        "view": "acai.findings",
        "contents": "The Acai server is not running. The Acai output channel has the details.\n[Restart Server](command:acai.restartServer)",
        "when": "acai.hasFolder && acai.serverState == error"
      },
      {
        "view": "acai.findings",
        "contents": "No audit yet for this folder.\n[Run Audit (Detectors)](command:acai.runAudit)\n[Run Agent Audit](command:acai.runAgentAudit)\nDetectors run locally. An agent audit needs a model: [set an Anthropic API key](command:acai.setApiKey) or ask Copilot Chat in agent mode to \"audit this project with Acai\".",
        "when": "acai.hasFolder && acai.serverState == running && !acai.hasAudit"
      },
      {
        "view": "acai.findings",
        "contents": "The latest audit has no findings.\n[Run Audit Again](command:acai.runAudit)\n[Open Dashboard](command:acai.openDashboard)",
        "when": "acai.hasFolder && acai.serverState == running && acai.hasAudit"
      }
    ],
    "commands": [
      {
        "command": "acai.openDashboard",
        "title": "Open Dashboard",
        "category": "Acai",
        "icon": "$(dashboard)"
      },
      {
        "command": "acai.openDashboardExternal",
        "title": "Open Dashboard in Browser",
        "category": "Acai",
        "icon": "$(link-external)"
      },
      {
        "command": "acai.runAudit",
        "title": "Run Audit (Detectors)",
        "category": "Acai",
        "icon": "$(play)"
      },
      {
        "command": "acai.runAgentAudit",
        "title": "Run Agent Audit",
        "category": "Acai",
        "icon": "$(sparkle)"
      },
      {
        "command": "acai.refresh",
        "title": "Refresh",
        "category": "Acai",
        "icon": "$(refresh)"
      },
      {
        "command": "acai.confirmFinding",
        "title": "Confirm Finding",
        "category": "Acai",
        "icon": "$(check)"
      },
      {
        "command": "acai.rejectFinding",
        "title": "Reject Finding\u2026",
        "category": "Acai",
        "icon": "$(close)"
      },
      {
        "command": "acai.reinvestigateFinding",
        "title": "Re-investigate Finding\u2026",
        "category": "Acai",
        "icon": "$(search)"
      },
      {
        "command": "acai.modifyFinding",
        "title": "Modify Finding in Dashboard",
        "category": "Acai",
        "icon": "$(edit)"
      },
      {
        "command": "acai.openFindingLocation",
        "title": "Go to Finding Location",
        "category": "Acai",
        "icon": "$(go-to-file)"
      },
      {
        "command": "acai.fixConfirmed",
        "title": "Fix Confirmed Findings",
        "category": "Acai",
        "icon": "$(wrench)"
      },
      {
        "command": "acai.acceptFix",
        "title": "Accept Fix",
        "category": "Acai",
        "icon": "$(pass)"
      },
      {
        "command": "acai.revertFix",
        "title": "Revert Fix",
        "category": "Acai",
        "icon": "$(discard)"
      },
      {
        "command": "acai.setApiKey",
        "title": "Set Anthropic API Key",
        "category": "Acai",
        "icon": "$(key)"
      },
      {
        "command": "acai.setOpenAIKey",
        "title": "Set OpenAI API Key",
        "category": "Acai",
        "icon": "$(key)"
      },
      {
        "command": "acai.clearApiKey",
        "title": "Clear API Keys",
        "category": "Acai"
      },
      {
        "command": "acai.showReport",
        "title": "Show Report",
        "category": "Acai",
        "icon": "$(output)"
      },
      {
        "command": "acai.restartServer",
        "title": "Restart Server",
        "category": "Acai",
        "icon": "$(debug-restart)"
      },
      {
        "command": "acai.selectFolder",
        "title": "Select Workspace Folder",
        "category": "Acai",
        "icon": "$(root-folder)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "acai.openDashboardExternal",
          "when": "acai.serverState == running"
        },
        {
          "command": "acai.selectFolder",
          "when": "workspaceFolderCount > 1"
        }
      ],
      "view/title": [
        {
          "command": "acai.runAudit",
          "when": "view == acai.findings",
          "group": "navigation@1"
        },
        {
          "command": "acai.openDashboard",
          "when": "view == acai.findings || view == acai.status",
          "group": "navigation@2"
        },
        {
          "command": "acai.refresh",
          "when": "view == acai.findings || view == acai.status",
          "group": "navigation@3"
        },
        {
          "command": "acai.runAgentAudit",
          "when": "view == acai.findings",
          "group": "1_audit@1"
        },
        {
          "command": "acai.fixConfirmed",
          "when": "view == acai.findings",
          "group": "1_audit@2"
        },
        {
          "command": "acai.showReport",
          "when": "view == acai.findings || view == acai.status",
          "group": "1_audit@3"
        },
        {
          "command": "acai.selectFolder",
          "when": "(view == acai.findings || view == acai.status) && workspaceFolderCount > 1",
          "group": "2_server@1"
        },
        {
          "command": "acai.setApiKey",
          "when": "view == acai.findings || view == acai.status",
          "group": "2_server@2"
        },
        {
          "command": "acai.restartServer",
          "when": "view == acai.findings || view == acai.status",
          "group": "2_server@3"
        }
      ],
      "view/item/context": [
        {
          "command": "acai.confirmFinding",
          "when": "view == acai.findings && viewItem == finding.open",
          "group": "inline@1"
        },
        {
          "command": "acai.rejectFinding",
          "when": "view == acai.findings && viewItem == finding.open",
          "group": "inline@2"
        },
        {
          "command": "acai.reinvestigateFinding",
          "when": "view == acai.findings && viewItem == finding.open",
          "group": "inline@3"
        },
        {
          "command": "acai.acceptFix",
          "when": "view == acai.findings && viewItem == finding.fix_ready",
          "group": "inline@1"
        },
        {
          "command": "acai.revertFix",
          "when": "view == acai.findings && viewItem == finding.fix_ready",
          "group": "inline@2"
        },
        {
          "command": "acai.confirmFinding",
          "when": "view == acai.findings && viewItem =~ /^finding\\.(open|withdrawn|fix_failed|reinvestigating)$/",
          "group": "1_review@1"
        },
        {
          "command": "acai.rejectFinding",
          "when": "view == acai.findings && viewItem =~ /^finding\\.(open|confirmed|withdrawn|fix_failed|reinvestigating)$/",
          "group": "1_review@2"
        },
        {
          "command": "acai.reinvestigateFinding",
          "when": "view == acai.findings && viewItem =~ /^finding\\.(open|confirmed|withdrawn|fix_failed|rejected)$/",
          "group": "1_review@3"
        },
        {
          "command": "acai.acceptFix",
          "when": "view == acai.findings && viewItem == finding.fix_ready",
          "group": "1_review@4"
        },
        {
          "command": "acai.revertFix",
          "when": "view == acai.findings && viewItem == finding.fix_ready",
          "group": "1_review@5"
        },
        {
          "command": "acai.openFindingLocation",
          "when": "view == acai.findings && viewItem =~ /^finding\\./",
          "group": "2_open@1"
        },
        {
          "command": "acai.modifyFinding",
          "when": "view == acai.findings && viewItem =~ /^finding\\./",
          "group": "2_open@2"
        }
      ],
      "editor/title": [
        {
          "command": "acai.openDashboardExternal",
          "when": "activeWebviewPanelId == acai.dashboard",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Acai",
      "properties": {
        "acai.provider": {
          "type": "string",
          "enum": [
            "auto",
            "anthropic",
            "openai",
            "openai-compatible",
            "none"
          ],
          "enumDescriptions": [
            "Anthropic when its key is set, else an OpenAI-compatible endpoint when a base URL is set, else OpenAI when its key is set, else none.",
            "Claude through the Anthropic API (Acai: Set Anthropic API Key or ANTHROPIC_API_KEY).",
            "OpenAI's API through the Responses API, with web search for research (Acai: Set OpenAI API Key or OPENAI_API_KEY).",
            "An on-premise or self-hosted model behind an OpenAI-compatible API (set Acai: Openai Base Url and Acai: Model).",
            "No model. Detectors run locally; agent mode in Copilot Chat can do the reasoning through MCP."
          ],
          "default": "auto",
          "description": "Model provider for agent audits, re-investigations and fixes run by the Acai server."
        },
        "acai.model": {
          "type": "string",
          "default": "",
          "description": "Model id. Empty means the provider default (claude-opus-5-5 for Anthropic, gpt-5.5 for OpenAI). Required for openai-compatible."
        },
        "acai.openaiBaseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Base URL of an OpenAI-compatible endpoint, for example http://gpu-box:8000/v1. Only settable in user settings, so a repository cannot redirect code excerpts."
        },
        "acai.stateDir": {
          "type": "string",
          "default": "",
          "description": "Where audit state lives. Empty means <folder>/.acai. Relative paths resolve against the workspace folder."
        },
        "acai.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show findings that need attention in the Problems panel and as squiggles in the editor."
        },
        "acai.reviewerName": {
          "type": "string",
          "default": "",
          "description": "Name recorded in the audit trail for your review decisions. Empty means your OS user name."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "acai",
        "label": "Acai compliance audit"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node build.mjs && vsce package --no-dependencies --allow-missing-repository --out ../../dist/acai-vscode.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.0.0"
  }
}
